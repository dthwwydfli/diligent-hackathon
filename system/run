#!/usr/bin/env python3
"""Namesake entrypoint: system/run <data folder> <output file>."""

from __future__ import annotations

import os
import sys

# Allow importing namesake whether invoked as ./system/run or python system/run.
_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from namesake.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
